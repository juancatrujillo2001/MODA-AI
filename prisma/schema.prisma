generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
}

enum ClosetSource {
  SAVED
  PURCHASED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  BRAND_PRODUCT
  TREND
}

// ─── Models ──────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  username         String    @unique
  password         String
  avatar           String?
  bio              String?
  height           Float?
  weight           Float?
  bodyMeasurements Json?
  profilePhoto     String?
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts         Post[]
  likes         Like[]
  comments      Comment[]
  savedPosts    SavedPost[]
  closetItems   ClosetItem[]
  cartItems     CartItem[]
  orders        Order[]
  notifications Notification[]
  tryOnResults  TryOnResult[]

  followers Follow[] @relation("following")
  following Follow[] @relation("followers")

  @@map("users")
}

model Post {
  id            String    @id @default(cuid())
  userId        String
  mediaUrl      String
  mediaType     MediaType
  caption       String?
  aiDescription String?
  colorPalette  Json?
  detectedItems Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
  savedBy  SavedPost[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("saved_posts")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  logo        String?
  description String?
  createdAt   DateTime @default(now())

  garments Garment[]

  @@map("brands")
}

model Garment {
  id          String   @id @default(cuid())
  name        String
  brandId     String
  category    String
  subcategory String?
  sizes       Json
  colors      Json
  price       Decimal  @db.Decimal(10, 2)
  description String?
  photos      Json
  sku         String   @unique
  stock       Int      @default(0)
  createdAt   DateTime @default(now())

  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  closetItems  ClosetItem[]
  cartItems    CartItem[]
  tryOnResults TryOnResult[]

  @@index([brandId])
  @@index([category])
  @@map("garments")
}

model ClosetItem {
  id        String       @id @default(cuid())
  userId    String
  garmentId String
  source    ClosetSource
  createdAt DateTime     @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([userId, garmentId])
  @@map("closet_items")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  garmentId String
  size      String
  color     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  items           Json
  total           Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model TryOnResult {
  id         String   @id @default(cuid())
  userId     String
  garmentId  String
  resultImage String  // base64 or URL of generated image
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([userId, garmentId])
  @@map("tryon_results")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}
